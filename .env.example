# Copy to .env and fill in.
# EXPO_PUBLIC_ prefix is required for Expo to expose a var to app code —
# same idea as Vite's VITE_ prefix in the web app's .env.

# Same Supabase project as the website (camping_map) — same data, same login.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# The SAME "Web application" Google Cloud OAuth Client ID already created for
# the website's Google sign-in — not a new one. See src/lib/useAuth.ts for
# why only this one (not the separate Android client) goes in code.
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your-google-web-client-id
